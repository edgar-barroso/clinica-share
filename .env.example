# Database
DATABASE_URL="postgresql://clinicashare:clinicashare@localhost:5433/clinicashare?schema=public"

# Node Environment
NODE_ENV="development"

# Base URL da aplicação
APP_URL="http://localhost:3000"

# JWT secret usado para assinar tokens de sessão (cookie auth-token)
JWT_SECRET="change-me-to-a-long-random-string"

# Gmail (App Password) para envio de e-mails de reset de senha
EMAIL_SERVICE_USER_EMAIL="seu-email@gmail.com"
EMAIL_SERVICE_USER_PASSWORD="sua-app-password"

# Google OAuth — apenas client ID (fluxo client-side, sem client_secret)
NEXT_PUBLIC_GOOGLE_CLIENT_ID="xxxxxxxx.apps.googleusercontent.com"

# Seed inicial: admin criado por `npm run db:seed` (idempotente, DEC-P08)
ADMIN_EMAIL="admin@clinicashare.local"
ADMIN_PASSWORD="change-me-on-first-login"
ADMIN_NOME="Dr. Edson Andrade"
