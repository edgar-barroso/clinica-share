        <mxCell id="legenda" value="LEGENDA&#xa;━━━━━━━━━━━━━━━━━━━━━━━━&#xa;Cores:&#xa;  azul   = autenticação (User)&#xa;  verde  = pessoas (Profissional, Staff, Paciente)&#xa;  amarelo= espaço/recurso físico (Consultorio, TurnoFixo) + enums&#xa;  vermelho = núcleo financeiro/operacional (Atendimento, Repasse, Services)&#xa;  roxo   = transversal (AuditLog, Configuracao)&#xa;&#xa;Visibilidade:  +público   -privado   #protegido&#xa;Cardinalidade: 1, 0..1, 0..*, 1..*&#xa;Estereótipos: «entity» «service» «enumeration» «infra» «core»&#xa;&#xa;Regras inegociáveis sinalizadas:&#xa;  RNF-101: valores Decimal (10,2) / (12,2)&#xa;  RNF-102: AuditLog obrigatório em alteração financeira&#xa;  RNF-103: cálculo só no servidor (CalculoRepasseService)&#xa;  RNF-104: cálculo coberto por testes unitários&#xa;  RNF-105: dados clínicos fora do schema relacional (prontuarioInterno: JSON)" style="text;html=1;strokeColor=#666666;fillColor=#f5f5f5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;spacingLeft=10;spacingRight=10;spacingTop=10;spacingBottom=10;fontSize=11;" vertex="1" parent="1">
